<Window x:Class="AutoParkManager.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация въезда" Height="520" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ВЪЕЗД АВТОМОБИЛЯ" 
                   FontSize="22" FontWeight="Bold" 
                   Foreground="#6C5CE7" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>

        <!-- Гос. номер -->
        <TextBlock Grid.Row="1" Text="Гос. номер (А000АА00)" Foreground="White" FontSize="14" Margin="0,5,0,5"/>

        <!-- Используем StackPanel для TextBox + кнопка подбора -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="CarNumberBox" 
                     Width="300" Height="35" 
                     FontSize="14"
                     MaxLength="9"
                     PreviewTextInput="CarNumberBox_PreviewTextInput"
                     TextChanged="CarNumberBox_TextChanged"/>
            <Button Content="▼" Width="92" Height="37"
                    Background="#6C5CE7" Foreground="White" FontWeight="Bold"
                    Click="LoadCarNumbers_Click" ToolTip="Выбрать из списка" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="0.449"/>
                        <RotateTransform/>
                        <TranslateTransform Y="0.392"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </StackPanel>

        <!-- Марка с выпадающим списком -->
        <TextBlock Grid.Row="3" Text="Марка автомобиля" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
        <ComboBox Grid.Row="4" x:Name="CarBrandCombo" 
                  Height="35" Margin="0,0,0,15"
                  IsEditable="True" 
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True">
            <ComboBoxItem Content="Toyota"/>
            <ComboBoxItem Content="Honda"/>
            <ComboBoxItem Content="Hyundai"/>
            <ComboBoxItem Content="Kia"/>
            <ComboBoxItem Content="Nissan"/>
            <ComboBoxItem Content="Mitsubishi"/>
            <ComboBoxItem Content="BMW"/>
            <ComboBoxItem Content="Mercedes"/>
            <ComboBoxItem Content="Audi"/>
            <ComboBoxItem Content="Volkswagen"/>
            <ComboBoxItem Content="Ford"/>
            <ComboBoxItem Content="Chevrolet"/>
            <ComboBoxItem Content="Renault"/>
            <ComboBoxItem Content="Lada"/>
            <ComboBoxItem Content="ГАЗ"/>
            <ComboBoxItem Content="УАЗ"/>
        </ComboBox>

        <!-- Постоянный клиент -->
        <TextBlock Grid.Row="5" Text="Постоянный клиент" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
        <ComboBox Grid.Row="6" x:Name="ClientCombo" Height="35" Margin="0,0,0,20" DisplayMemberPath="DisplayText"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Зарегистрировать въезд" 
                    Width="200" Height="40" 
                    FontSize="14" FontWeight="Bold"
                    Background="#00B894" Foreground="White" 
                    Cursor="Hand" Click="Save_Click" Margin="5"/>
            <Button Content="Отмена" 
                    Width="100" Height="40" 
                    FontSize="14"
                    Background="#FF7675" Foreground="White" 
                    Cursor="Hand" Click="Cancel_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>