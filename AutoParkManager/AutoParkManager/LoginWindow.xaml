<Window x:Class="AutoParkManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ResizeMode="NoResize">

    <Grid>
        <Border Background="#2D2D3D" CornerRadius="20" Width="400" Height="350" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="AutoParkManager" FontSize="24" FontWeight="Bold" 
                           Foreground="#6C5CE7" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1" Text="Логин" Foreground="White" FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="2" x:Name="LoginBox" FontSize="14" Height="35" Margin="0,5" Background="#3A3A4A" Foreground="White"/>

                <TextBlock Grid.Row="3" Text="Пароль" Foreground="White" FontSize="14" Margin="0,5"/>
                <PasswordBox Grid.Row="4" x:Name="PasswordBox" FontSize="14" Height="35" Margin="0,5" Background="#3A3A4A" Foreground="White"/>

                <Button Grid.Row="5" Content="Войти" Height="40" FontSize="14" FontWeight="Bold" Margin="0,20"
                        Background="#6C5CE7" Foreground="White" Cursor="Hand" Click="Login_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>