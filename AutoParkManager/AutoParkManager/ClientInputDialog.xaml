<Window x:Class="AutoParkManager.ClientInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление клиента" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="480">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20" Width="440">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ДОБАВЛЕНИЕ КЛИЕНТА" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#6C5CE7" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <!-- ФИО -->
            <TextBlock Grid.Row="1" Text="ФИО" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
            <TextBox Grid.Row="2" x:Name="FullNameBox" FontSize="14" Height="35" Margin="0,0,0,15"/>

            <!-- Телефон -->
            <TextBlock Grid.Row="3" Text="Телефон" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
            <TextBox Grid.Row="4" x:Name="PhoneBox" FontSize="14" Height="35" Margin="0,0,0,15"/>

            <!-- Гос. номер -->
            <TextBlock Grid.Row="5" Text="Гос. номер (А000АА00)" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
            <TextBox Grid.Row="6" x:Name="CarNumberBox" 
                     FontSize="14" Height="35" Margin="0,0,0,15"
                     MaxLength="9"
                     PreviewTextInput="CarNumberBox_PreviewTextInput"
                     TextChanged="CarNumberBox_TextChanged"/>

            <!-- Марка автомобиля -->
            <TextBlock Grid.Row="7" Text="Марка автомобиля" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
            <ComboBox Grid.Row="8" x:Name="CarBrandCombo" 
                      Height="35" Margin="0,0,0,15"
                      IsEditable="True" 
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True">
                <ComboBoxItem Content="Toyota"/>
                <ComboBoxItem Content="Honda"/>
                <ComboBoxItem Content="Hyundai"/>
                <ComboBoxItem Content="Kia"/>
                <ComboBoxItem Content="Nissan"/>
                <ComboBoxItem Content="Mitsubishi"/>
                <ComboBoxItem Content="BMW"/>
                <ComboBoxItem Content="Mercedes"/>
                <ComboBoxItem Content="Audi"/>
                <ComboBoxItem Content="Volkswagen"/>
                <ComboBoxItem Content="Ford"/>
                <ComboBoxItem Content="Chevrolet"/>
                <ComboBoxItem Content="Renault"/>
                <ComboBoxItem Content="Lada"/>
                <ComboBoxItem Content="ГАЗ"/>
                <ComboBoxItem Content="УАЗ"/>
            </ComboBox>

            <!-- Кнопки -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
                <Button Content="Сохранить" Width="120" Height="35" FontSize="14" FontWeight="Bold"
                        Background="#00B894" Foreground="White" Cursor="Hand" Click="Save_Click" Margin="10,0,10,0"/>
                <Button Content="Отмена" Width="120" Height="35" FontSize="14"
                        Background="#FF7675" Foreground="White" Cursor="Hand" Click="Cancel_Click" Margin="10,0,10,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>