<Window x:Class="AutoParkManager.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты" Height="550" Width="740"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 ГЕНЕРАЦИЯ ОТЧЁТОВ" FontSize="22" FontWeight="Bold" 
                   Foreground="#6C5CE7" HorizontalAlignment="Left" Margin="90,0,0,25" Grid.Column="1"/>

        <!-- Карточки отчётов -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,10,0,10" Width="690" Grid.ColumnSpan="2">
            <Border Background="#2D2D3D" CornerRadius="15" Width="200" Height="120" Margin="10" Cursor="Hand" MouseDown="RevenueReport_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Выручка" FontSize="16" FontWeight="Bold" Foreground="#00B894" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Отчёт по платежам" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#2D2D3D" CornerRadius="15" Width="200" Height="120" Margin="10" Cursor="Hand" MouseDown="AbonementsReport_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎫" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Абонементы" FontSize="16" FontWeight="Bold" Foreground="#6C5CE7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Активные абонементы" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#2D2D3D" CornerRadius="15" Width="200" Height="120" Margin="10" Cursor="Hand" MouseDown="ParkingLoadReport_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📈" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Загрузка" FontSize="16" FontWeight="Bold" Foreground="#E17055" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Анализ загрузки" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Лог -->
        <Border Grid.Row="2" Background="#2D2D3D" CornerRadius="10" Padding="15" Margin="0,20,0,0" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Журнал операций" Foreground="#6C5CE7" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" 
                         Background="Transparent" Foreground="#AAAAAA" FontSize="12" 
                         VerticalScrollBarVisibility="Auto" Height="150"/>
            </Grid>
        </Border>
    </Grid>
</Window>