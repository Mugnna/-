<Window x:Class="AutoParkManager.ExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выезд и оплата" Height="650" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ВЫЕЗД И ОПЛАТА" 
                   FontSize="22" FontWeight="Bold" 
                   Foreground="#E17055" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Список активных автомобилей -->
        <TextBlock Grid.Row="1" Text="Выберите автомобиль из списка" Foreground="White" FontSize="14" Margin="0,5,0,5"/>
        <ListBox Grid.Row="2" x:Name="ActiveCarsList" 
                 Height="120" Margin="0,0,0,15"
                 Background="#2D2D3D" Foreground="White" FontSize="14"
                 SelectionChanged="ActiveCarsList_SelectionChanged"/>

        <!-- Или введите номер вручную -->
        <TextBlock Grid.Row="3" Text="Или введите номер вручную" Foreground="#AAAAAA" FontSize="12" Margin="0,5,0,5"/>
        <TextBox Grid.Row="4" x:Name="CarNumberBox" Height="35" Margin="0,0,0,15" FontSize="14"/>

        <Button Grid.Row="5" Content="Найти автомобиль" Width="160" Height="40" Margin="0,5"
                Background="#6C5CE7" Foreground="White" FontWeight="Bold" Click="Find_Click"/>

        <!-- Информация о сессии -->
        <Border Grid.Row="6" Background="#2D2D3D" CornerRadius="10" Padding="15" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Время въезда:" Foreground="#AAAAAA"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EntryTimeText" Foreground="White" FontWeight="Bold" Margin="10,5,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Время выезда:" Foreground="#AAAAAA"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ExitTimeText" Foreground="White" FontWeight="Bold" Margin="10,5,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Длительность:" Foreground="#AAAAAA"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DurationText" Foreground="#00B894" FontWeight="Bold" Margin="10,5,0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Сумма к оплате:" Foreground="#E17055" FontWeight="Bold" FontSize="16"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AmountText" Foreground="#E17055" FontSize="20" FontWeight="Bold" Margin="10,5,0,5"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="Оплатить (наличные)" Width="190" Height="45" Click="PayCash_Click"
                    Background="#00B894" Foreground="White" FontWeight="Bold" FontSize="14" Margin="5"/>
            <Button Content="Оплатить (карта)" Width="190" Height="45" Click="PayCard_Click"
                    Background="#0984E3" Foreground="White" FontWeight="Bold" FontSize="14" Margin="5"/>
        </StackPanel>

        <Button Grid.Row="8" Content="Отмена" Width="100" Height="35" Click="Cancel_Click"
                Background="#FF7675" Foreground="White" Margin="0,10,0,0"/>
    </Grid>
</Window>