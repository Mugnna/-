<Window x:Class="AutoParkManager.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление клиентами" Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="КЛИЕНТЫ И АБОНЕМЕНТЫ" FontSize="22" FontWeight="Bold" Foreground="#00B894" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" RowHeaderWidth="0" Margin="0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding CarNumber}" Width="120"/>
                <DataGridTextColumn Header="Марка" Binding="{Binding CarBrand}" Width="100"/>
                <DataGridTextColumn Header="Абонемент" Binding="{Binding AbonementName}" Width="100"/>
                <DataGridTextColumn Header="Действителен до" Binding="{Binding AbonementEndDate, StringFormat='dd.MM.yyyy'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="Добавить клиента" Width="150" Height="35" Background="#00B894" Foreground="White" Click="AddClient_Click" Margin="5"/>
            <Button Content="Оформить абонемент" Width="150" Height="35" Background="#6C5CE7" Foreground="White" Click="AddAbonement_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>