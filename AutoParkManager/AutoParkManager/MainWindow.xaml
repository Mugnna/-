<Window x:Class="AutoParkManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoParkManager" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0,15,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#3A3A4A"/>
            <Setter Property="RowBackground" Value="#2D2D3D"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Статистика -->
        <Border Grid.Row="0" Background="#2D2D3D" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Активные автомобили -->
                <Border Grid.Column="0" Background="#3A3A4A" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚗" FontSize="28" Foreground="#6C5CE7" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ActiveCarsCount" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="на стоянке" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Выручка за сегодня -->
                <Border Grid.Column="1" Background="#3A3A4A" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="28" Foreground="#00B894" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TodayRevenue" Text="0 ₽" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="выручка за сегодня" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Всего машин за сегодня -->
                <Border Grid.Column="2" Background="#3A3A4A" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="28" Foreground="#E17055" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TodayVisits" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="машин за сегодня" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Активные абонементы -->
                <Border Grid.Column="3" Background="#3A3A4A" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎫" FontSize="28" Foreground="#FDCB6E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ActiveAbonementsCount" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="активных абонементов" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <Border Grid.Row="1" Background="#2D2D3D" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="AutoParkManager" FontSize="28" FontWeight="Bold" Foreground="#6C5CE7"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="EntryBtn" Content="Въезд" Style="{StaticResource ModernButton}"
                            Background="#00B894" Click="Entry_Click"/>
                    <Button x:Name="ExitBtn" Content="Выезд" Style="{StaticResource ModernButton}"
                            Background="#E17055" Click="Exit_Click"/>
                    <Button x:Name="ClientsBtn" Content="Клиенты" Style="{StaticResource ModernButton}"
                            Background="#0984E3" Click="Clients_Click"/>
                    <Button x:Name="ReportsBtn" Content="Отчёты" Style="{StaticResource ModernButton}"
                            Background="#6C5CE7" Click="Reports_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        

        <!-- Таблица активных сессий -->
        <Border Grid.Row="2" Background="#2D2D3D" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Активные сессии" FontSize="18" FontWeight="Bold" Foreground="#6C5CE7" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="ActiveSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер авто" Binding="{Binding CarNumber}" Width="150"/>
                        <DataGridTextColumn Header="Марка" Binding="{Binding CarBrand}" Width="120"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="200"/>
                        <DataGridTextColumn Header="Время въезда" Binding="{Binding EntryTime, StringFormat='dd.MM.yyyy HH:mm'}" Width="160"/>
                        <DataGridTextColumn Header="Текущая стоимость" Binding="{Binding CurrentCost, StringFormat='0.00 руб'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>